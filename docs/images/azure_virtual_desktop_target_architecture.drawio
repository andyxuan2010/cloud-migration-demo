  <diagram id="azure-avd" name="Azure Virtual Desktop">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="background" value="" style="fillColor=#f7fafc;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2400" height="1600" as="geometry"/></mxCell><mxCell id="title" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:44px;font-weight:700;color:#17395f;&quot;&gt;Azure Virtual Desktop — Small-Business Target Architecture&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="28" width="2250" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:22px;color:#60738c;&quot;&gt;6–10 users | Entra cloud identity | pooled Windows 11 multi-session | office PCs as access terminals&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="59" y="88" width="2250" height="35" as="geometry"/></mxCell><mxCell id="edge-signin" value="sign-in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0e7490;strokeWidth=3;endArrow=block;endFill=1;fontColor=#60738c;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="340" as="sourcePoint"/><mxPoint x="752" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge-saas" value="SaaS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#ad6805;strokeWidth=3;endArrow=block;endFill=1;fontColor=#60738c;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1710" y="340" as="sourcePoint"/><mxPoint x="1762" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge-network" value="network" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0e7490;strokeWidth=3;endArrow=block;endFill=1;fontColor=#60738c;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="950" as="sourcePoint"/><mxPoint x="752" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge-optional" value="optional" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c58b08;strokeWidth=3;dashed=1;dashPattern=12 10;endArrow=block;endFill=1;fontColor=#60738c;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="1395" as="sourcePoint"/><mxPoint x="2000" y="1395" as="targetPoint"/></mxGeometry></mxCell><mxCell id="left-panel" value="" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#0e7490;strokeWidth=3;shadow=0;" vertex="1" parent="1"><mxGeometry x="45" y="145" width="655" height="1250" as="geometry"/></mxCell><mxCell id="left-pill" value="FRONTEND / ACCESS" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#0e7490;strokeColor=#0e7490;strokeWidth=1;fontColor=#ffffff;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="67" y="161" width="262" height="44" as="geometry"/></mxCell><mxCell id="middle-panel" value="" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#edf9f5;strokeColor=#0f766e;strokeWidth=3;shadow=0;" vertex="1" parent="1"><mxGeometry x="752" y="145" width="958" height="1250" as="geometry"/></mxCell><mxCell id="middle-pill" value="BACKEND / CONTROL PLANE" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#0f766e;strokeColor=#0f766e;strokeWidth=1;fontColor=#ffffff;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="774" y="161" width="334" height="44" as="geometry"/></mxCell><mxCell id="right-panel" value="" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#fff6e9;strokeColor=#ad6805;strokeWidth=3;shadow=0;" vertex="1" parent="1"><mxGeometry x="1762" y="145" width="593" height="1250" as="geometry"/></mxCell><mxCell id="right-pill" value="SAAS / DATA / OPERATIONS" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#ad6805;strokeColor=#ad6805;strokeWidth=1;fontColor=#ffffff;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1784" y="161" width="346" height="44" as="geometry"/></mxCell><mxCell id="left-0-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e7490;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="85" y="220" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-0-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Access devices&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;10 Windows 11 client PCs&lt;br&gt;Windows App / Remote Desktop client&lt;br&gt;Standard users; local lockdown&lt;br&gt;Display, keyboard, audio and peripherals&lt;br&gt;No business data by default&lt;br&gt;BitLocker + recovery process&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="85" y="220" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-1-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e7490;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="85" y="510" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-1-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Users and workflow&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Entra user launches AVD&lt;br&gt;MFA / Conditional Access&lt;br&gt;Outbound HTTPS 443&lt;br&gt;UDP RDP Shortpath where feasible&lt;br&gt;No inbound RDP or public host IPs&lt;br&gt;Router/firewall DHCP + DNS&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="85" y="510" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-2-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e7490;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="85" y="800" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-2-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;LAN and peripherals&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Printers, scanners, webcams, mics and USB&lt;br&gt;Explicit redirection test matrix&lt;br&gt;Office productivity depends on Internet&lt;br&gt;Terminal is not the desktop workload&lt;br&gt;Document outage fallback&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="85" y="800" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-3-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e7490;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="85" y="1090" width="575" height="200" as="geometry"/></mxCell><mxCell id="left-3-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Optional mobility&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Approved home or secondary device&lt;br&gt;Windows App or browser client&lt;br&gt;Same Entra identity + MFA&lt;br&gt;No direct office access; separate approval&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="85" y="1090" width="575" height="200" as="geometry"/></mxCell><mxCell id="middle-0-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="790" y="220" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-0-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Entra ID and access&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Cloud-authoritative identity&lt;br&gt;MFA + Conditional Access&lt;br&gt;AVD authentication / SSO&lt;br&gt;RBAC for AVD, storage and Intune&lt;br&gt;Break-glass administrators&lt;br&gt;No AD DS required in baseline&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="220" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-1-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1245" y="220" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-1-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;AVD service&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Workspace + desktop application group&lt;br&gt;Pooled host pool + broker&lt;br&gt;Reverse-connect gateway over HTTPS&lt;br&gt;Session assignment + drain mode&lt;br&gt;Diagnostics + connection monitoring&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1245" y="220" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-2-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="790" y="510" width="414" height="295" as="geometry"/></mxCell><mxCell id="middle-2-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Session-host pool&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Windows 11 Enterprise multi-session&lt;br&gt;Standardized golden image&lt;br&gt;Office, Chrome and Google apps&lt;br&gt;Defender + security baseline&lt;br&gt;Intune if licensed&lt;br&gt;One-host pilot, 2+ for availability&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="510" width="414" height="295" as="geometry"/></mxCell><mxCell id="middle-3-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1245" y="510" width="414" height="295" as="geometry"/></mxCell><mxCell id="middle-3-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;FSLogix profile and storage&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;FSLogix profile containers&lt;br&gt;Azure Files + Entra Kerberos&lt;br&gt;Cloud-only identity path; pilot validation&lt;br&gt;Shared drives remain source of truth&lt;br&gt;Profiles are not a full backup&lt;br&gt;Restore test and retention&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1245" y="510" width="414" height="295" as="geometry"/></mxCell><mxCell id="middle-4-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="790" y="850" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-4-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Operations and cost / controls&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Autoscale by schedule and demand&lt;br&gt;Start/stop nonproduction hosts&lt;br&gt;Azure Monitor + Log Analytics&lt;br&gt;Budgets, alerts and tags&lt;br&gt;Replace image; no in-place upgrade&lt;br&gt;Backup and recovery runbook&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="850" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-5-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1245" y="850" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-5-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Network and session / security&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;VNet, subnets and NSGs&lt;br&gt;Private endpoints only if justified&lt;br&gt;No inbound RDP&lt;br&gt;Encrypted disks and profile data&lt;br&gt;Defender and vulnerability monitoring&lt;br&gt;Regional outage plan&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1245" y="850" width="414" height="245" as="geometry"/></mxCell><mxCell id="right-0-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ad6805;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1805" y="220" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-0-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Google Workspace&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Gmail, Drive, Docs and shared drives&lt;br&gt;Browser-first collaboration&lt;br&gt;Drive for desktop only after multi-session test&lt;br&gt;Independent Workspace backup&lt;br&gt;Company-owned accounts and data&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1805" y="220" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-1-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ad6805;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1805" y="510" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-1-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Microsoft and other apps&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Office in the session-host image&lt;br&gt;License and activation validated&lt;br&gt;Approved communication tools&lt;br&gt;Legacy apps only if compatible&lt;br&gt;No untested kernel drivers or USB dependencies&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1805" y="510" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-2-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ad6805;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1805" y="800" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-2-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Azure data and recovery&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Azure Files snapshots/backup&lt;br&gt;Session-host image versioning&lt;br&gt;Azure backup and restore drills&lt;br&gt;Google backup remains separate&lt;br&gt;RTO/RPO documented&lt;br&gt;Exit path to local or another cloud&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1805" y="800" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-3-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ad6805;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1805" y="1090" width="507" height="200" as="geometry"/></mxCell><mxCell id="right-3-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Optional mobility&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Approved remote client/device&lt;br&gt;Same Entra identity + MFA/CA&lt;br&gt;Managed device or controlled BYOD&lt;br&gt;No direct office access; separate approval&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1805" y="1090" width="507" height="200" as="geometry"/></mxCell><mxCell id="gate" value="AD DS dependency removed / gate passed" style="rounded=1;arcSize=18;fillColor=#fff4f4;strokeColor=#d63b32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="1358" width="380" height="42" as="geometry"/></mxCell><mxCell id="legend-mandatory" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:16px;color:#60738c;&quot;&gt;━━━━━━━━ &amp;nbsp; mandatory control or data flow&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="75" y="1460" width="310" height="35" as="geometry"/></mxCell><mxCell id="legend-optional" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:16px;color:#60738c;&quot;&gt;━━━━━━━━ &amp;nbsp; optional or conditional flow&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="535" y="1460" width="330" height="35" as="geometry"/></mxCell><mxCell id="footer" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:16px;color:#60738c;text-align:right;&quot;&gt;Centralized desktop, explicit cost, availability and dependency gates&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1700" y="1460" width="620" height="35" as="geometry"/></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>
