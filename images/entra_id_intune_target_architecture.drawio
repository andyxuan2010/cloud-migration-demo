      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="background" value="" style="fillColor=#f7fafc;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2400" height="1600" as="geometry"/></mxCell><mxCell id="title" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:44px;font-weight:700;color:#17395f;&quot;&gt;Entra ID + Intune — Small-Business Target Architecture&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="58" y="28" width="2250" height="55" as="geometry"/></mxCell><mxCell id="subtitle" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:22px;color:#60738c;&quot;&gt;10 Windows PCs | Microsoft cloud control | local productivity | no permanent domain controller&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="59" y="88" width="2250" height="35" as="geometry"/></mxCell><mxCell id="edge-signin" value="sign-in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=3;endArrow=block;endFill=1;fontColor=#60738c;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="340" as="sourcePoint"/><mxPoint x="752" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge-saas" value="SaaS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c25b06;strokeWidth=3;endArrow=block;endFill=1;fontColor=#60738c;fontSize=16;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1710" y="340" as="sourcePoint"/><mxPoint x="1762" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="edge-network" value="network" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2563eb;strokeWidth=3;endArrow=block;