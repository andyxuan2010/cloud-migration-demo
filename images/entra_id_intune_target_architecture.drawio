" y="145" width="593" height="1250" as="geometry"/></mxCell><mxCell id="right-pill" value="SAAS / DATA / OPERATIONS" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#c25b06;strokeColor=#c25b06;strokeWidth=1;fontColor=#ffffff;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1784" y="161" width="346" height="44" as="geometry"/></mxCell><mxCell id="left-0-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="85" y="220" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-0-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Access devices&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;10 Windows 11 Pro PCs&lt;br&gt;Entra joined&lt;br&gt;Intune enrolled and compliant&lt;br&gt;Standard users; controlled elevation&lt;br&gt;BitLocker, Defender, Windows LAPS&lt;br&gt;Printers, scanners, webcams&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="85" y="220" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-1-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="85" y="510" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-1-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Users and workflow&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Named user sign-in + MFA&lt;br&gt;Office where licensed&lt;br&gt;Chrome / approved browsers&lt;br&gt;Google Drive for desktop or browser&lt;br&gt;Local apps and peripherals stay on PC&lt;br&gt;Local work continues during some cloud outages&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="85" y="510" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-2-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="85" y="800" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-2-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;LAN and peripherals&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Router/firewall supplies DHCP&lt;br&gt;DNS forwarding + guest Wi-Fi isolation&lt;br&gt;Outbound cloud access only&lt;br&gt;No inbound Internet RDP&lt;br&gt;Replace AD DNS/DHCP/file/print dependencies&lt;br&gt;Document rollback and outage behavior&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="85" y="800" width="575" height="245" as="geometry"/></mxCell><mxCell id="left-3-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563eb;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="85" y="1090" width="575" height="200" as="geometry"/></mxCell><mxCell id="left-3-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Optional mobility&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Approved remote location/device&lt;br&gt;Same Entra identity + MFA/CA&lt;br&gt;Managed device or controlled BYOD&lt;br&gt;No direct RDP/SMB; separate approval&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="85" y="1090" width="575" height="200" as="geometry"/></mxCell><mxCell id="middle-0-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="790" y="220" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-0-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Entra ID&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Authoritative workforce identity&lt;br&gt;Verified domain + named users&lt;br&gt;MFA / Conditional Access&lt;br&gt;SSPR + break-glass accounts&lt;br&gt;Groups, RBAC, audit logs&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="220" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-1-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1245" y="220" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-1-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Intune management&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Enrollment + Autopilot&lt;br&gt;Configuration + compliance&lt;br&gt;Apps + update rings&lt;br&gt;BitLocker key escrow&lt;br&gt;Defender, firewall, Windows LAPS&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1245" y="220" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-2-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="790" y="510" width="414" height="295" as="geometry"/></mxCell><mxCell id="middle-2-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Policy and operations&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Pilot → Standard → Exception&lt;br&gt;Security baseline + least privilege&lt;br&gt;Compliance gates access where needed&lt;br&gt;Exception-based inventory and alerts&lt;br&gt;Cloud-admin runbooks&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="510" width="414" height="295" as="geometry"/></mxCell><mxCell id="middle-3-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1245" y="510" width="414" height="295" as="geometry"/></mxCell><mxCell id="middle-3-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Microsoft services and / integration&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Office licensing and activation&lt;br&gt;Optional Defender for Business&lt;br&gt;Google SAML SSO / provisioning&lt;br&gt;No Azure compute required&lt;br&gt;SaaS lifecycle remains documented&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1245" y="510" width="414" height="295" as="geometry"/></mxCell><mxCell id="middle-4-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="790" y="850" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-4-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Recovery and endpoint / control&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Independent Google Workspace backup&lt;br&gt;Endpoint/local-data backup if needed&lt;br&gt;Device wipe, rebuild and key recovery&lt;br&gt;Replacement PC process&lt;br&gt;Sample restore tests&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="790" y="850" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-5-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f766e;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1245" y="850" width="414" height="245" as="geometry"/></mxCell><mxCell id="middle-5-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Network and retirement&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Cloud DNS/DHCP or router&lt;br&gt;Certificates, VPN and RADIUS remediated&lt;br&gt;AD dependency inventory&lt;br&gt;AD DS decommission gate&lt;br&gt;No permanent domain controller&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1245" y="850" width="414" height="245" as="geometry"/></mxCell><mxCell id="right-0-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c25b06;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1805" y="220" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-0-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Google Workspace&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Gmail, Drive, Docs and shared drives&lt;br&gt;Entra SAML SSO if selected&lt;br&gt;Provisioning + offboarding&lt;br&gt;Google remains collaboration platform&lt;br&gt;Ownership and file mapping verified&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1805" y="220" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-1-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c25b06;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1805" y="510" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-1-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Business data and apps&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Office files and approved SaaS&lt;br&gt;Application inventory&lt;br&gt;No LDAP/Kerberos assumption&lt;br&gt;Backup separate from synchronization&lt;br&gt;Company-controlled data&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1805" y="510" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-2-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c25b06;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1805" y="800" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-2-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Provider portability&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Exports and company-owned domains&lt;br&gt;Tenant and billing ownership&lt;br&gt;Replacement-device rebuild&lt;br&gt;Support-transfer documentation&lt;br&gt;Vendor exit plan&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1805" y="800" width="507" height="245" as="geometry"/></mxCell><mxCell id="right-3-box" value="" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c25b06;strokeWidth=2;shadow=1;" vertex="1" parent="1"><mxGeometry x="1805" y="1090" width="507" height="200" as="geometry"/></mxCell><mxCell id="right-3-text" value="&lt;div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:24px;font-weight:700;line-height:1.08;color:#17395f;&quot;&gt;Optional mobility&lt;/div&gt;&lt;div style=&quot;font-family:Arial,sans-serif;font-size:18px;line-height:1.45;color:#25364d;margin-top:16px;&quot;&gt;Approved remote location/device&lt;br&gt;Same identity, MFA and Conditional Access&lt;br&gt;Managed device or controlled BYOD&lt;br&gt;No direct RDP/SMB; separate approval&lt;/div&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1805" y="1090" width="507" height="200" as="geometry"/></mxCell><mxCell id="gate" value="AD DS dependency removed / gate passed" style="rounded=1;arcSize=18;fillColor=#fff4f4;strokeColor=#d63b32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="230" y="1358" width="380" height="42" as="geometry"/></mxCell><mxCell id="legend-mandatory" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:16px;color:#60738c;&quot;&gt;━━━━━━━━ &amp;nbsp; mandatory control or data flow&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="75" y="1460" width="310" height="35" as="geometry"/></mxCell><mxCell id="legend-optional" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:16px;color:#60738c;&quot;&gt;━━━━━━━━ &amp;nbsp; optional or conditional flow&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="535" y="1460" width="330" height="35" as="geometry"/></mxCell><mxCell id="footer" value="&lt;div style=&quot;font-family:Arial,sans-serif;font-size:16px;color:#60738c;text-align:right;&quot;&gt;Cloud control plane, local productivity, minimal infrastructure&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacing=0;" vertex="1" parent="1"><mxGeometry x="1700" y="1460" width="620" height="35" as="geometry"/></mxCell></root>
